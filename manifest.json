{
  "manifest_version": 3,
  "name": "NetSnap",
  "version": "1.0.0",
  "description": "一键录制浏览器网络请求，导出 HAR 文件并提取 Cookie。无需打开 DevTools。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["debugger", "downloads", "activeTab", "tabs", "storage"]
}
